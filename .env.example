# Copy to .env. Explicitly accept Minecraft's EULA before starting backends:
# https://aka.ms/MinecraftEULA
EULA=FALSE
# Set a private random secret, e.g. python3 -c 'import secrets; print(secrets.token_hex(32))'
# The same secret is used by the proxy and every backend. Do not commit .env.
FORWARDING_SECRET=

# 2–64 backends. Use ./docker/compose.py for all Compose commands.
SERVER_COUNT=2
PROXY_MEMORY=512M
BACKEND_MEMORY=3G
# Shared proxy display and backend capacity, 1–1024 players.
MAX_PLAYERS=100
SWAP_INTERVAL_SECONDS=300
START_COUNTDOWN_SECONDS=5
VELOCITY_PORT=25577

# Matching mod, proxy, and Docker build version.
DEATHSWAP_VERSION=1.0.0
